# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────
# Required in production! A secret key users must enter to access the dashboard.
# Generate one: openssl rand -hex 32
DASHBOARD_SECRET=your-super-secret-key-here

# ── Container Restart ────────────────────────────────────────────
# Optional token to authorize container restarts via POST /api/container/:name/restart
RESTART_TOKEN=

# ── Alert Thresholds (percentage) ────────────────────────────────
ALERT_CPU=80
ALERT_MEMORY=80
ALERT_DISK=85

# ── Sampling ─────────────────────────────────────────────────────
SAMPLE_INTERVAL=2000

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info
